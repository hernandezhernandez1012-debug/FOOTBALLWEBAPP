Use AllWebUIServerClasses.pkg
Use cConnection.pkg
Use cWebMenuItemLoadView.pkg

Object oApplication is a cApplication
    Object oConnection is a cConnection
        Use LoginEncryption.pkg
    End_Object
End_Object

Object oWebApp is a cWebApp
    Set psTheme to "Df_Material"
    Set peApplicationStyle to wvsDrillDown
    Set peApplicationStateMode to asmHistoryAndUrls
    Set psEncryptPassword to "FutbolWebApp_Desarrollo_2026"
    Object oViewStack is a cWebViewStack
            End_Object

    Object oCommandbar is a cWebCommandBar                
        Object oMenuBar is a cWebMenuBar
            Object oFileMenu is a cWebMenuItem
                Set psCaption to C_$File
                
                Object oClearMenuItem is a cWebMenuClear
                End_Object  
                             
                Object oClearAllMenuItem is a cWebMenuClearAll
                End_Object  
                
                Object oPromptMenuItem is a cWebMenuPrompt
                    Set pbBeginGroup to True
                End_Object  
                               
                Object oFindMenuItem is a cWebMenuFind
                End_Object  

                Object oNextMenuItem is a cWebMenuFindNext
                End_Object  

                Object oPreviousMenuItem is a cWebMenuFindPrevious
                End_Object  
                
                Object oLastMenuItem is a cWebMenuFindLast
                End_Object                
                                
                Object oFirstMenuItem is a cWebMenuFindFirst
                End_Object  
                
                Object oSaveMenuItem is a cWebMenuSave
                    Set pbBeginGroup to True
                End_Object  
                
                Object oDeleteMenuItem is a cWebMenuDelete
                End_Object  
                
                Object oLoginMenuItem is a cWebMenuItem
                    Set psCaption to C_$LogIn
                    Set pbBeginGroup to True
                    Set psCSSClass to "WebLoginMenuItem"

                    Procedure OnClick
                        Send RequestLogin to (SessionManager(Self))
                    End_Procedure
                    
                    Procedure OnLoad
                        Integer eLoginMode
                        Handle hoLogin
                        Get GetLoginView to hoLogin
                        Get peLoginMode to eLoginMode
                        WebSet pbRender to  (hoLogin and eLoginMode<>lmLoginNone)
                    End_Procedure  // OnLoad
                    
                End_Object  

                Object oLogoutMenuItem is a cWebMenuItem
                    Set psCaption to C_$LogOut
                    Set psCSSClass to "WebLogoutMenuItem"

                    Procedure OnClick
                        Send RequestLogOut of (SessionManager(Self))
                    End_Procedure

                    Procedure OnLoad
                        Integer eLoginMode
                        Handle hoLogin
                        Get GetLoginView to hoLogin
                        Get peLoginMode to eLoginMode
                        WebSet pbRender to  (hoLogin and eLoginMode<>lmLoginNone)
                    End_Procedure
                End_Object  
            End_Object  
    
            Object oViewMenu is a cWebMenuItem
                Set psCaption to C_$View

                Object oListadodeentrenadoresItem1 is a cWebMenuItemLoadView
                    Set psCaption to "Listado de entrenadores"
                    Set psLoadViewOnClick to "oSelectEntrenador"
                End_Object

                Object oFichadeEntrenadorItem1 is a cWebMenuItemLoadView
                    Set psCaption to "ficha de Entrenador"
                    Set psLoadViewOnClick to "oZoomEntrenador"
                End_Object

                Object oListadejugadoresItem1 is a cWebMenuItemLoadView
                    Set psCaption to "Lista de jugadores"
                    Set psLoadViewOnClick to "oSelectJugador"
                End_Object

                Object oFichadejugadorItem1 is a cWebMenuItemLoadView
                    Set psCaption to "ficha de jugador"
                    Set psLoadViewOnClick to "oZoomJugador"
                End_Object

                Object oPosiciondeljugadorItem1 is a cWebMenuItemLoadView
                    Set psCaption to "posicion del jugador"
                    Set psLoadViewOnClick to "oSelectPosicion"
                End_Object

                Object oPosiciondeljugadorItem2 is a cWebMenuItemLoadView
                    Set psCaption to "posicion del jugador"
                    Set psLoadViewOnClick to "oZoomPosicion"
                End_Object

                Object oListadeEquiposItem1 is a cWebMenuItemLoadView
                    Set psCaption to "Lista de Equipos"
                    Set psLoadViewOnClick to "oSelectEquipo"
                End_Object

                Object oListadeEquiposItem2 is a cWebMenuItemLoadView
                    Set psCaption to "Lista de Equipos"
                    Set psLoadViewOnClick to "oZoomEquipo"
                End_Object

                Object oListadeLigasItem1 is a cWebMenuItemLoadView
                    Set psCaption to "lista de Ligas"
                    Set psLoadViewOnClick to "oSelectLiga"
                End_Object

                Object oListadeligasItem2 is a cWebMenuItemLoadView
                    Set psCaption to "lista de ligas"
                    Set psLoadViewOnClick to "oZoomLiga"
                End_Object
            End_Object  
        End_Object  
        
        Object oFindToolBar is a cWebToolBar
            Object oFirstMenuItem is a cWebMenuFindFirst
            End_Object  
    
            Object oPreviousMenuItem is a cWebMenuFindPrevious
            End_Object  

            Object oFindMenuItem is a cWebMenuFind
            End_Object  

            Object oNextMenuItem is a cWebMenuFindNext
            End_Object  
            
            Object oLastMenuItem is a cWebMenuFindLast
            End_Object
                           
            Object oPromptMenuItem is a cWebMenuPrompt
            End_Object 
        End_Object
        
        Object oFileToolBar is a cWebToolBar
            Set pbShowCaption to True
            
            Object oClearMenuItem is a cWebMenuClear
            End_Object              
             
            Object oClearAllMenuItem is a cWebMenuClearAll
            End_Object   
                        
            Object oSaveMenuItem is a cWebMenuSave
            End_Object  
            
            Object oDeleteMenuItem is a cWebMenuDelete
            End_Object 
        End_Object
    End_Object

    Use SessionManager.wo
    Use LoginDialog.wo
    Use WebResourceManager.wo
    Use SelectEntrenador.wo
    Use ZoomEntrenador.wo
    Use SelectJugador.wo
    Use ZoomJugador.wo
    Use SelectPosicion.wo
    Use ZoomPosicion.wo
    Use SelectEquipo.wo
    Use ZoomEquipo.wo
    Use SelectLiga.wo
    Use ZoomLiga.wo
    
End_Object

Send StartWebApp of oWebApp
